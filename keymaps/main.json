{
  // Bound on the pane item itself, which is where focus lands when the canvas
  // is clicked. The root must never carry native-key-bindings: core resolves
  // every arrow under that class to native! at higher specificity than these,
  // which findKeyBindings cannot see — the keys exist and simply never fire.
  ".graviss": {
    "[": "graviss:previous-graphic",
    "]": "graviss:next-graphic",
    "f": "graviss:fit-view",
    "i": "graviss:view-isometric",
    "t": "graviss:view-top",
    "e": "graviss:view-front",
    "r": "graviss:view-right",
    "p": "graviss:perspective-projection",
    "o": "graviss:orthographic-projection",
    "m": "graviss:toggle-members",
    "s": "graviss:toggle-shells",
    "n": "graviss:toggle-nodes",
    "u": "graviss:toggle-supports",
    "w": "graviss:toggle-mesh",
    "g": "graviss:toggle-grid",
    "a": "graviss:toggle-axes",
    "l": "graviss:toggle-local-axes",
    "d": "graviss:toggle-section-rendering",
    "b": "graviss:choose-background",
    "left": "graviss:move-left",
    "right": "graviss:move-right",
    "up": "graviss:move-up",
    "down": "graviss:move-down",
    "alt-left": "graviss:rotate-left",
    "alt-right": "graviss:rotate-right",
    "alt-up": "graviss:rotate-up",
    "alt-down": "graviss:rotate-down",
    "+": "graviss:zoom-in",
    "=": "graviss:zoom-in",
    "-": "graviss:zoom-out",
    "_": "graviss:zoom-out"
  }
}
